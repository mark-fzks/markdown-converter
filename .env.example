# Copy to .env and adjust. On Coolify, set these as environment variables
# on the service instead of committing a .env file.

# --- authentication ---------------------------------------------------------
# Both must be set for auth to be enforced. Leave empty ONLY if the service is
# unreachable from the internet.
AUTH_USERNAME=mark
AUTH_PASSWORD=change-me-to-something-long
AUTH_REALM=markdown-converter

# --- conversion defaults ----------------------------------------------------
DEFAULT_PDF_ENGINE=typst        # typst | weasyprint
DEFAULT_THEME=default
THEMES_DIR=/app/themes
REVEALJS_URL=https://unpkg.com/reveal.js@4

# --- mermaid ----------------------------------------------------------------
MERMAID_ENABLED=true
MERMAID_THEME=default           # default | neutral | dark | forest | base
MERMAID_SCALE=3                 # raster scale factor for PNG output

# --- limits -----------------------------------------------------------------
MAX_UPLOAD_MB=32
MAX_UNPACKED_MB=256             # ceiling for an uploaded zip once expanded
MAX_BATCH_FILES=200
CONVERSION_TIMEOUT=120          # seconds per document
MAX_CONCURRENT_CONVERSIONS=2    # raise on a bigger server

# --- misc -------------------------------------------------------------------
LOG_LEVEL=INFO

